{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leapstone",
  "version": "1.2.4",
  "identifier": "nl.leapstone.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix web run dev:app",
    "beforeBuildCommand": "npm --prefix web run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "Leapstone"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://leapstone.visser-william.workers.dev wss://leapstone.visser-william.workers.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "developmentTeam": "S9DZ7L5BVD"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "leapstone.visser-william.workers.dev",
          "pathPrefix": [
            "/uitnodiging/"
          ],
          "appLink": true
        }
      ]
    }
  }
}
