  "license": "AGPL-3.0-only",
  "description": "Leapstone: Chinese checkers and Halma app (Tauri 2, Svelte, Bevy 3D WASM, Cloudflare Worker).",
  "homepage": "https://playleapstone.com",
  "repository": {
    "type": "git",
