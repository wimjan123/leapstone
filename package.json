  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app:android:dev": "node scripts/android.mjs dev",
    "app:android:build": "node scripts/android.mjs build",
    "app:android:telefoon": "node scripts/android.mjs telefoon",
    "app:android:winkel": "node scripts/android.mjs winkel",
