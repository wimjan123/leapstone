# Koppen op alle static assets (Cloudflare Workers).
# Het spel (/play/) krijgt geen CSP: het gebruikt WebAssembly, inline stijlen en praat met de API. Wel de rest hieronder.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Bestanden van de build (/assets/) hebben een code in de naam en veranderen nooit: een nieuwe versie krijgt een nieuwe naam.
# (Een 404 op dit adres haalt de Worker uit de cache: spel::bewaartijd_van_fout, taak 291.)
# De browser mag ze dus een jaar bewaren zonder de server iets te vragen. Dit vervangt de standaard van Cloudflare
# (public, max-age=0, must-revalidate). Alleen /assets/: /badges/, /fonts/ en /rules/img/ houden hun naam bij een wijziging.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# De Landingspagina heeft één klein inline script (doorsturen naar het spel voor wie de web-app op het beginscherm zette).
# De hash hieronder hoort bij dat script. web/src/headers.test.ts controleert dat hij klopt.
/
  Content-Security-Policy: default-src 'none'; script-src 'sha256-EgnXHvSzUGYqrbVmX0X4tGsvxm96XYX0s1FuJs4DsOs='; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Privacy en gebruiksregels: alleen tekst en inline stijl.
/privacy
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/terms
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Spelregelpagina's (/rules/<naam>) en hun plaatjes (SVG): alleen tekst, inline stijl en eigen beelden. Geen JavaScript.
/rules/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

