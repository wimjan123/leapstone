{
  "name": "leapstone-web",
  "private": true,
  "version": "1.2.4",
  "license": "AGPL-3.0-only",
  "homepage": "https://playleapstone.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wimjan123/leapstone.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/halma-core --target web --out-dir ../../web/src/wasm --out-name halma_core",
    "wasm3d": "wasm-pack build ../crates/halma-bord3d --target web --out-dir ../../web/src/wasm3d --out-name halma_bord3d --profile wasm-release -- --features app",
    "bak-bord3d": "node scripts/bak-bord3d/bak.mjs && node scripts/bak-bord3d/omgeving.mjs",
    "wasm3d:snel": "wasm-pack build ../crates/halma-bord3d --target web --out-dir ../../web/src/wasm3d --out-name halma_bord3d --profile wasm-snel --no-opt -- --features app",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && npm run build:site",
    "build:site": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "test": "npm run wasm && vitest run",
    "schermen": "node scripts/schermen.mjs",
    "meet-bord": "node scripts/meet-bord.mjs",
    "meet-laden": "node scripts/meet-laden.mjs",
    "knopplaten": "node scripts/knopplaten.mjs",
    "knopletters": "node scripts/knopletters.mjs",
    "icons": "node scripts/make-icons.mjs",
    "landing-beelden": "node scripts/make-landing.mjs",
    "landing:paginas": "node scripts/make-landing-paginas.mjs",
    "voorbeeldkaart": "node scripts/make-voorbeeldkaart.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "regels": "cargo run -q -p halma-core --example regelplaatjes -- public/rules/img && node scripts/make-regels.mjs",
    "regels:paginas": "node scripts/make-regels.mjs",
    "hout": "node scripts/make-wood.mjs",
    "dev:app": "npm run wasm && vite --mode app",
    "build:app": "npm run wasm && npm run wasm3d && svelte-check --tsconfig ./tsconfig.json && vite build --mode app"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wasm-pack": "^0.15.1",
    "workbox-build": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "xz-decompress": "^0.2.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-deep-link": "^2.6.3"
  }
}
